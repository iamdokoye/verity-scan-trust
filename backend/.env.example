# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]
SUPABASE_ANON_KEY=[anon-key]
SUPABASE_JWKS_URL=https://[project-ref].supabase.co/auth/v1/.well-known/jwks.json

# Database (Supabase PostgreSQL via Prisma)
# Use the Session Mode pooler URL here (IPv4, works on most networks)
# Supabase Dashboard → Project Settings → Database → Connection string → Session mode
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Direct connection — used only by Prisma migrate/studio (bypasses pooler)
# Supabase Dashboard → Project Settings → Database → Connection string → URI
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Storage (bucket must be created manually in Supabase Dashboard → Storage)
SUPABASE_STORAGE_BUCKET=votta-documents

# Cryptography
# Run: npm run keys:generate — paste the output of PRIVATE_KEY here
INSTITUTION_PRIVATE_KEY_PEM=
# Run: npm run keys:generate — paste the output of PUBLIC_KEY here
INSTITUTION_PUBLIC_KEY_PEM=

# App — set to the URL where the Next.js frontend is served
FRONTEND_URL=http://localhost:3000
